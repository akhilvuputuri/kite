{
  // Only the entry point and a declaration file are listed: tsc compiles what they import
  // as well. rootDir is left for tsc to work out, and every file is a module whatever it
  // contains. Of two `paths` patterns that match, the longer prefix wins.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "inlineSourceMap": true,
    "inlineSources": true,
    "outDir": "${configDir}/dist",
    "paths": { "*": ["./other/*"], "@lib/*": ["./lib/*"] }
  },
  "files": ["src/index.ts", "src/globals.d.ts"],
  "exclude": ["src/excluded.ts"]
}
